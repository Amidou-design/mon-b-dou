# =====================================================
# MON BÉDOU ORCHESTRATOR — Variables d'environnement
# Copiez ce fichier en `.env` puis remplissez les valeurs.
# NE JAMAIS commiter le fichier `.env`.
# =====================================================

# Clé API OpenAI (obligatoire)
# Utilisée pour transformer un objectif texte en instruction structurée.
OPENAI_API_KEY=

# Modèle OpenAI (optionnel, défaut : gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Clé API BLACKBOX Agent (obligatoire)
# Bearer token pour l'API https://agent.blackbox.ai/api/v1
BLACKBOX_API_KEY=

# Repository GitHub à analyser/modifier par Blackbox
BLACKBOX_REPO_URL=https://github.com/Amidou-design/mon-b-dou.git

# Branche du repository (optionnel, défaut : master)
BLACKBOX_BRANCH=master

# Timeout HTTP global en millisecondes (optionnel, défaut : 30000)
# HTTP_TIMEOUT_MS=30000

# Intervalle de polling du statut en millisecondes (optionnel, défaut : 5000)
# POLL_INTERVAL_MS=5000
